		<variableExpression>$F{CGC_CPF}</variableExpression>
	</variable>
	<variable name="Campos.Tipo_Pessoa" class="java.lang.String">
		<variableExpression>$F{TIPPESSOA}</variableExpression>
	</variable>
	<variable name="Campos.Historico" class="java.lang.String">
		<variableExpression>$F{HISTORICO}</variableExpression>
	</variable>
	<variable name="Campos.Tipo_Titulo" class="java.lang.String">
		<variableExpression>$F{CODTIPTIT}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Numero_unico_nota" class="java.lang.String">
		<variableExpression>$F{NUNOTA}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Cod_Natureza" class="java.lang.String">
		<variableExpression>$F{CODNAT}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Carta" class="java.lang.String">
		<variableExpression>$F{CARTA}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Cod_Conta" class="java.lang.String">
		<variableExpression>BoletoHelper.buscaDadosConta($P{REPORT_CONNECTION},$F{CODBCO},$F{CODCTABCOINT},"CODCTABCO")</variableExpression>
	</variable>
	<variable name="Campos.Descricao_Conta" class="java.lang.String">
		<variableExpression>BoletoHelper.buscaDadosConta($P{REPORT_CONNECTION},$F{CODBCO},$F{CODCTABCOINT},"DESCRICAO")</variableExpression>
	</variable>
	<variable name="Campos.Data_da_baixa" class="java.lang.String">
		<variableExpression>new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{DHBAIXA})</variableExpression>
	</variable>
	<variable name="Campos.Ordem_Carga" class="java.lang.String">
		<variableExpression>$F{ORDEMCARGA}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Numero_Renegociacao" class="java.lang.String">
		<variableExpression>$F{NURENEG}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Provisao" class="java.lang.String">
		<variableExpression>$F{PROVISAO}</variableExpression>
	</variable>
	<variable name="Campos.Descricao_Tipo_Titulo" class="java.lang.String">
		<variableExpression>$F{DESCRTIPTIT}</variableExpression>
	</variable>
	<variable name="Campos.Perc_Desconto_Financeiro" class="java.lang.String">
		<variableExpression>$F{DESCFINPAR}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Cod_Contato" class="java.lang.String">
		<variableExpression>$F{CODCONTATO}.toString()</variableExpression>
	</variable>
	<variable name="Campos.Nome_Contato" class="java.lang.String">
		<variableExpression>$F{NOMECONTATOCTT}</variableExpression>
	</variable>
	<variable name="Campos.Apelido_Contato" class="java.lang.String">
		<variableExpression>$F{APELIDOCTT}</variableExpression>
	</variable>
	<variable name="qtd_tit_venc" class="java.lang.String">
		<variableExpression>StringUtils.padl(BoletoHelper.buscaDadosConta($P{REPORT_CONNECTION},$F{CODBCO},$F{CODCTABCOINT},"CARTEIRA") ,2)</variableExpression>
	</variable>
	<variable name="CODAGE" class="java.lang.String">
		<variableExpression>$F{LINHADIGITAVEL}.substring(4,5) +
$F{LINHADIGITAVEL}.substring(6,9) + "-" +
$F{LINHADIGITAVEL}.substring(10,11)</variableExpression>
	</variable>
	<variable name="TAXADIAATRASOPAR" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "ISNULL(PAR.PERCJURO,0)",
     "TGFPAR PAR , TGFFIN FIN",
     "PAR.CODPARC = FIN.CODPARC AND FIN.NUFIN = " + $F{NUFIN}.toString()
).toString()</variableExpression>
		<initialValueExpression>"0"</initialValueExpression>
	</variable>
	<variable name="PERCMULTAPAR" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "ISNULL(PAR.PERCMULTA,0)",
     "TGFPAR PAR , TGFFIN FIN",
     "PAR.CODPARC = FIN.CODPARC AND FIN.NUFIN = " + $F{NUFIN}.toString()
).toString()</variableExpression>
		<initialValueExpression />
	</variable>
	<variable name="TAXADIAATRASO" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "PAR.NUMDEC",
     "TSIPAR PAR",
     "PAR.CHAVE = " + "'TAXADIAATRASO'"
).toString()</variableExpression>
	</variable>
	<variable name="NOTAS_FISCAIS" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "FIN.NUMNOTA",
     "TGFFIN FIN",
     "FIN.NUMDUPL = " + $F{NUMDUPL}.toString()
).toString()</variableExpression>
	</variable>
	<variable name="VLR_DESDOB_NOTAS" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "SUM(FIN.VLRDESDOB)",
     "TGFFIN FIN",
     "FIN.NUMDUPL = ISNULL(" + $F{NUMDUPL}.toString() + "," + $F{NUFIN}.toString() + ")"
).toString()</variableExpression>
	</variable>
	<variable name="RETORNA_RENEG_OU_NOTA" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "RENEG_NOTA",
     "BH_VGF_TGFFIN_RENEGOC_NOTA",
     "NUFIN = " + $F{NUFIN}.toString()
).toString()</variableExpression>
	</variable>
	<variable name="PERCMULTA" class="java.lang.String">
		<variableExpression>Funcoes.pdes(     $P{REPORT_CONNECTION},      "PAR.NUMDEC",      "TSIPAR PAR",      "PAR.CHAVE = " + "'PERCMULTA'" ).toString()</variableExpression>
	</variable>
	<variable name="CONTA9DIG" class="java.lang.String">
		<variableExpression>Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "sankhya.lpad(CTA.CODCTABCO,9,'0')",
     "TSICTA CTA, TGFFIN FIN",
     "FIN.CODEMP = " + $F{CODEMP}.toString() + "AND CTA.CODCTABCOINT = FIN.CODCTABCOINT AND FIN.NUFIN = " + $F{NUFIN}.toString()
)</variableExpression>
	</variable>
	<group name="AGRUPAMENTO_BOLETA">
		<groupExpression>(1 == $P{PTIPAGRUPAMENTO}.intValue()) ?
   (Object)$F{NUFIN}:
     (2 == $P{PTIPAGRUPAMENTO}.intValue()) ?
        (Object)($F{CODPARC}.toString() + ":" + $F{DTVENC}.getTime()):
     (3 == $P{PTIPAGRUPAMENTO}.intValue()) ?
         (Object)($F{CODPARC}.toString() + ":" + $F{DTVENC}.getTime() + ":" + $F{NUMDUPL}.toString()):
     (4 == $P{PTIPAGRUPAMENTO}.intValue()) ?
         (Object)$F{NOSSONUM}:
     (5 == $P{PTIPAGRUPAMENTO}.intValue()) ?
         (Object)($F{CODPARC}.toString()):
         (Object) $F{NUFIN}</groupExpression>
