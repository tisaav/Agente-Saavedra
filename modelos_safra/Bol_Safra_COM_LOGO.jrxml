	</variable>
	<variable name="CODAGE" class="java.lang.String">
		<variableExpression><![CDATA[$F{LINHADIGITAVEL}.substring(4,5) +
$F{LINHADIGITAVEL}.substring(6,9) + "-" +
$F{LINHADIGITAVEL}.substring(10,11)]]></variableExpression>
	</variable>
	<variable name="TAXADIAATRASOPAR" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "ISNULL(PAR.PERCJURO,0)",
     "TGFPAR PAR , TGFFIN FIN",
     "PAR.CODPARC = FIN.CODPARC AND FIN.NUFIN = " + $F{NUFIN}.toString()
).toString()]]></variableExpression>
		<initialValueExpression><![CDATA["0"]]></initialValueExpression>
	</variable>
	<variable name="PERCMULTAPAR" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "ISNULL(PAR.PERCMULTA,0)",
     "TGFPAR PAR , TGFFIN FIN",
     "PAR.CODPARC = FIN.CODPARC AND FIN.NUFIN = " + $F{NUFIN}.toString()
).toString()]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="TAXADIAATRASO" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "PAR.NUMDEC",
     "TSIPAR PAR",
     "PAR.CHAVE = " + "'TAXADIAATRASO'"
).toString()]]></variableExpression>
	</variable>
	<variable name="NOTAS_FISCAIS" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "FIN.NUMNOTA",
     "TGFFIN FIN",
     "FIN.NUMDUPL = " + $F{NUMDUPL}.toString()
).toString()]]></variableExpression>
	</variable>
	<variable name="VLR_DESDOB_NOTAS" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "SUM(FIN.VLRDESDOB)",
     "TGFFIN FIN",
     "FIN.NUMDUPL = ISNULL(" + $F{NUMDUPL}.toString() + "," + $F{NUFIN}.toString() + ")"
).toString()]]></variableExpression>
	</variable>
	<variable name="RETORNA_RENEG_OU_NOTA" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "RENEG_NOTA",
     "BH_VGF_TGFFIN_RENEGOC_NOTA",
     "NUFIN = " + $F{NUFIN}.toString()
).toString()]]></variableExpression>
	</variable>
	<variable name="PERCMULTA" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(     $P{REPORT_CONNECTION},      "PAR.NUMDEC",      "TSIPAR PAR",      "PAR.CHAVE = " + "'PERCMULTA'" ).toString()]]></variableExpression>
	</variable>
	<variable name="CONTA9DIG" class="java.lang.String">
		<variableExpression><![CDATA[Funcoes.pdes(
    $P{REPORT_CONNECTION},
     "sankhya.lpad(CTA.CODCTABCO,9,'0')",
     "TSICTA CTA, TGFFIN FIN",
     "FIN.CODEMP = " + $F{CODEMP}.toString() + "AND CTA.CODCTABCOINT = FIN.CODCTABCOINT AND FIN.NUFIN = " + $F{NUFIN}.toString()
)]]></variableExpression>
	</variable>
	<group name="AGRUPAMENTO_BOLETA">
		<groupExpression><![CDATA[(1 == $P{PTIPAGRUPAMENTO}.intValue()) ?
   (Object)$F{NUFIN}:
     (2 == $P{PTIPAGRUPAMENTO}.intValue()) ?
        (Object)($F{CODPARC}.toString() + ":" + $F{DTVENC}.getTime()):
     (3 == $P{PTIPAGRUPAMENTO}.intValue()) ?
         (Object)($F{CODPARC}.toString() + ":" + $F{DTVENC}.getTime() + ":" + $F{NUMDUPL}.toString()):
     (4 == $P{PTIPAGRUPAMENTO}.intValue()) ?
         (Object)$F{NOSSONUM}:
     (5 == $P{PTIPAGRUPAMENTO}.intValue()) ?
         (Object)($F{CODPARC}.toString()):
         (Object) $F{NUFIN}]]></groupExpression>
